# Painel fora dos buscadores e sem listagem de arquivos.
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "same-origin"
</IfModule>
<FilesMatch "^(lib\.php|\.user\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
